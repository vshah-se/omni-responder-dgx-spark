# ==============================================================================
# Custom VLM NIM Configuration (Cosmos Reasoner on DGX Spark)
# Usage: deploy/docker/scripts/dev-profile.sh up -p base -H DGX-SPARK --vlm-env-file <path_to_this_file>
# ==============================================================================

# Model Definition
VLM_MODEL_NAME=nvidia/cosmos-reason2-8b

# Video Processing & Frame Ingestion Limits
NIM_MAX_NUM_FRAMES=64
NIM_FPS=2
MAX_CONCURRENT_VIDEO_STREAMS=4

# Memory Allocation for VLM Engine
GPU_MEMORY_UTILIZATION=0.85
NIM_MAX_MODEL_LEN=65536

# Server Tuning
LOG_LEVEL=INFO
