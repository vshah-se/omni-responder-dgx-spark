# ==============================================================================
# Custom LLM NIM Configuration (DGX Spark - Grace Blackwell 128GB Unified Memory)
# Usage: deploy/docker/scripts/dev-profile.sh up -p base -H DGX-SPARK --llm-env-file <path_to_this_file>
# ==============================================================================

# Model Definition
NIM_MODEL_NAME=nvidia/NVIDIA-Nemotron-Nano-9B-v2-FP8

# Memory & Concurrency Tuning for DGX Spark
# Keep memory utilization tuned so both LLM & VLM share the 128GB unified memory pool
GPU_MEMORY_UTILIZATION=0.40
KV_CACHE_DTYPE=fp8
NIM_MAX_NUM_SEQS=16
NIM_MAX_MODEL_LEN=8192

# Parallelism (Single GB10 SoC)
TENSOR_PARALLEL_SIZE=1
PIPELINE_PARALLEL_SIZE=1

# Server & Performance Tuning
VLLM_ATTENTION_BACKEND=FLASH_ATTN
LOG_LEVEL=INFO
